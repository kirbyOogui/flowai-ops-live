# ─────────────────────────────────────────────
# FlowAI OPS（本物版）環境変数
# このファイルを .env にコピーして値を設定してください:  cp .env.example .env
# ─────────────────────────────────────────────

# ── 基本 ──
# PostgreSQL 接続文字列（docker compose up -d で起動するローカルDBならこのままで動きます）
DATABASE_URL="postgresql://flowai:flowai@localhost:5433/flowai_live?schema=public"
# アプリの公開URL（OAuth のリダイレクト先や、フォームのリンクに使います。末尾のスラッシュなし）
APP_URL="http://localhost:3000"
# 紹介ページからリンクする、誰でも触れるデモ版のURL（任意）
DEMO_URL=""

# ── ログイン（オーナー専用） ──
# ダッシュボードに入るためのパスワード（12文字以上を推奨）
ADMIN_PASSWORD=""
# セッションの署名鍵（openssl rand -base64 32 などで生成）
SESSION_SECRET=""
# 外部サービスのトークンを DB に保存するときの暗号鍵（32バイトを base64 で。openssl rand -base64 32）
ENCRYPTION_KEY=""

# ── AI ──
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-sol"
OPENAI_REASONING_EFFORT="low"
# AI 分析の回数上限（24時間あたり、全体）
AI_LIMIT_PER_DAY="200"

# ── Gmail ──
# Google Cloud の OAuth クライアント（ウェブ アプリケーション）。リダイレクト URI は {APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 受信をリアルタイムにする場合の Pub/Sub トピック（例: projects/my-project/topics/gmail-inbox）。空なら定期同期と手動同期のみ
GMAIL_PUBSUB_TOPIC=""
# Pub/Sub のプッシュ先 URL に付ける秘密の文字列（{APP_URL}/api/webhooks/gmail?token=この値）
GMAIL_PUSH_TOKEN=""

# ── Slack ──
# Slack アプリの Bot User OAuth Token（xoxb-…）と Signing Secret
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
# 依頼として取り込むチャンネルの ID（例: C0123456789）。空ならボットが参加している全チャンネル
SLACK_CHANNEL_ID=""

# ── フォーム ──
# 1つの IP アドレスから 1時間に送信できる回数
FORM_LIMIT_PER_HOUR="5"

# ── 定期実行（Vercel Cron） ──
# Vercel が Cron を呼ぶときに Authorization: Bearer として付ける値
CRON_SECRET=""
